# Copy this file to .env.local and enter your restricted browser API key.
VITE_GOOGLE_MAPS_API_KEY=
# DEMO_MAP_ID is for local testing. Create your own JavaScript map ID for deployment.
VITE_GOOGLE_MAP_ID=DEMO_MAP_ID
# Optional single-line Firebase web app configuration JSON.
VITE_FIREBASE_CONFIG=
# Optional Cloudflare Worker endpoint, including /resolve.
VITE_MAPS_LINK_RESOLVER_URL=
