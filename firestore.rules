rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function nicknameMatches(userId, name) {
      return exists(/databases/$(database)/documents/profiles/$(userId))
        && get(/databases/$(database)/documents/profiles/$(userId)).data.nickname == name;
    }
    function legacyMember() {
      return signedIn() && exists(/databases/$(database)/documents/settings/members)
        && get(/databases/$(database)/documents/settings/members).data.uids is list
        && get(/databases/$(database)/documents/settings/members).data.uids.size() <= 2
        && request.auth.uid in get(/databases/$(database)/documents/settings/members).data.uids;
    }
    function member(tripId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/sharedTrips/$(tripId)).data.memberIds;
    }
    function owner(tripId) {
      return signedIn() && get(/databases/$(database)/documents/sharedTrips/$(tripId)).data.ownerId == request.auth.uid;
    }
    function validTrip(tripId) {
      let d = request.resource.data;
      return d.keys().hasAll(['trip', 'revision', 'updatedAt', 'updatedBy', 'ownerId', 'memberIds', 'memberNames', 'inviteToken'])
        && d.keys().hasOnly(['trip', 'revision', 'updatedAt', 'updatedBy', 'ownerId', 'memberIds', 'memberNames', 'inviteToken'])
        && d.trip is map && d.trip.id == tripId && d.revision is int
        && d.updatedAt == request.time && d.updatedBy == request.auth.uid
        && d.ownerId is string && d.memberIds is list && d.memberIds.size() >= 1 && d.memberIds.size() <= 20
        && d.memberIds.toSet().size() == d.memberIds.size() && d.ownerId in d.memberIds
        && d.memberNames is map && d.memberNames.keys().hasAll(d.memberIds) && d.memberNames.keys().hasOnly(d.memberIds)
        && d.inviteToken is string && (d.inviteToken == '' || d.inviteToken.matches('^[a-f0-9]{64}$'));
    }
    function migration(tripId) {
      return legacyMember() && exists(/databases/$(database)/documents/trips/$(tripId))
        && !('migratedTo' in get(/databases/$(database)/documents/trips/$(tripId)).data)
        && getAfter(/databases/$(database)/documents/trips/$(tripId)).data.migratedTo == tripId
        && request.resource.data.trip == get(/databases/$(database)/documents/trips/$(tripId)).data.trip
        && request.resource.data.memberIds == get(/databases/$(database)/documents/settings/members).data.uids;
    }
    function approvedAddition(tripId) {
      let added = request.resource.data.memberIds.removeAll(resource.data.memberIds);
      return added.size() == 1 && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly(added)
        && request.resource.data.memberNames[added[0]] == get(/databases/$(database)/documents/sharedTrips/$(tripId)/requests/$(added[0])).data.displayName
        && get(/databases/$(database)/documents/sharedTrips/$(tripId)/requests/$(added[0])).data.status == 'pending'
        && getAfter(/databases/$(database)/documents/sharedTrips/$(tripId)/requests/$(added[0])).data.status == 'approved';
    }
    function accessChange(tripId) {
      let before = resource.data;
      let after = request.resource.data;
      return after.trip == before.trip && after.ownerId == before.ownerId
        && ((before.ownerId == request.auth.uid
          && ((after.memberIds == before.memberIds && after.memberNames == before.memberNames)
            || (before.memberIds.hasAll(after.memberIds) && before.memberIds.size() == after.memberIds.size() + 1
              && after.memberNames.diff(before.memberNames).affectedKeys().hasOnly(before.memberIds.removeAll(after.memberIds)))
            || approvedAddition(tripId)))
          || (request.auth.uid != before.ownerId && after.memberIds == before.memberIds.removeAll([request.auth.uid])
            && after.memberNames.diff(before.memberNames).affectedKeys().hasOnly([request.auth.uid])
            && after.inviteToken == before.inviteToken));
    }
    function nicknameChange() {
      let before = resource.data;
      let after = request.resource.data;
      return after.trip == before.trip && after.ownerId == before.ownerId
        && after.memberIds == before.memberIds && after.inviteToken == before.inviteToken
        && after.memberNames.diff(before.memberNames).affectedKeys().hasOnly([request.auth.uid])
        && nicknameMatches(request.auth.uid, after.memberNames[request.auth.uid]);
    }
    function validInvite(token) {
      let invitation = get(/databases/$(database)/documents/tripInvites/$(token)).data;
      return invitation.expiresAt > request.time
        && get(/databases/$(database)/documents/sharedTrips/$(invitation.tripId)).data.inviteToken == token;
    }
    match /settings/members { allow get: if legacyMember(); }
    match /profiles/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['nickname', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['nickname', 'updatedAt'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1 && request.resource.data.nickname.size() <= 20
        && request.resource.data.nickname.matches('^\\S(?:.*\\S)?$')
        && request.resource.data.nickname.matches('^[^\\x00-\\x1F\\x7F]+$')
        && request.resource.data.updatedAt == request.time;
    }
    match /trips/{tripId} {
      allow read: if legacyMember();
      allow update: if legacyMember() && !('migratedTo' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['migratedTo'])
        && request.resource.data.migratedTo == tripId
        && getAfter(/databases/$(database)/documents/sharedTrips/$(tripId)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/sharedTrips/$(tripId)).data.trip == resource.data.trip
        && getAfter(/databases/$(database)/documents/sharedTrips/$(tripId)).data.memberIds == get(/databases/$(database)/documents/settings/members).data.uids;
    }
    match /sharedTrips/{tripId} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/sharedTrips/$(tripId)) || request.auth.uid in resource.data.memberIds);
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn() && validTrip(tripId) && request.resource.data.revision == 1
        && request.resource.data.ownerId == request.auth.uid
        && nicknameMatches(request.auth.uid, request.resource.data.memberNames[request.auth.uid])
        && ((request.resource.data.memberIds == [request.auth.uid] && request.resource.data.inviteToken == '') || migration(tripId));
      allow update: if signedIn() && request.auth.uid in resource.data.memberIds && validTrip(tripId)
        && request.resource.data.revision == resource.data.revision + 1
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trip', 'revision', 'updatedAt', 'updatedBy'])
          || accessChange(tripId) || nicknameChange());
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      match /requests/{userId} {
        allow get: if signedIn() && (request.auth.uid == userId || owner(tripId));
        allow list: if owner(tripId);
        allow create, update: if signedIn() && request.auth.uid == userId
          && request.resource.data.keys().hasAll(['userId', 'displayName', 'status', 'inviteToken', 'createdAt'])
          && request.resource.data.keys().hasOnly(['userId', 'displayName', 'status', 'inviteToken', 'createdAt'])
          && request.resource.data.userId == userId && request.resource.data.status == 'pending'
          && request.resource.data.displayName is string && request.resource.data.displayName.size() >= 1 && request.resource.data.displayName.size() <= 60
          && nicknameMatches(request.auth.uid, request.resource.data.displayName)
          && request.resource.data.createdAt == request.time
          && !member(tripId) && validInvite(request.resource.data.inviteToken)
          && get(/databases/$(database)/documents/tripInvites/$(request.resource.data.inviteToken)).data.tripId == tripId;
        allow update: if owner(tripId) && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && (request.resource.data.status == 'rejected'
            || (request.resource.data.status == 'approved' && userId in getAfter(/databases/$(database)/documents/sharedTrips/$(tripId)).data.memberIds));
      }
    }
    match /tripInvites/{token} {
      allow get: if signedIn() && validInvite(token);
      allow create: if signedIn() && token.matches('^[a-f0-9]{64}$')
        && request.resource.data.keys().hasAll(['tripId', 'ownerId', 'tripName', 'createdAt', 'expiresAt'])
        && request.resource.data.keys().hasOnly(['tripId', 'ownerId', 'tripName', 'createdAt', 'expiresAt'])
        && owner(request.resource.data.tripId) && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.tripName is string && request.resource.data.tripName.size() <= 300
        && request.resource.data.createdAt == request.time && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time && request.resource.data.expiresAt <= request.time + duration.value(7, 'd')
        && getAfter(/databases/$(database)/documents/sharedTrips/$(request.resource.data.tripId)).data.inviteToken == token;
      allow delete: if owner(resource.data.tripId);
    }
  }
}
